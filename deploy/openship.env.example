# Copiar estas claves en Openship → proyecto → Environment.
# No commitear valores reales. Generar secretos en el Mac: `node deploy/generate-keys.mjs`.

NODE_ENV=production

# Postgres interno (no se publica). 32+ caracteres:  openssl rand -hex 24
POSTGRES_PASSWORD=

# URL pública del web, exacta, con https:// y sin slash final.
# La API rechaza POST cuyo Origin no esté aquí (CSRF).
WEB_ORIGIN=https://eventos.TU-DOMINIO

# Firmas Ed25519 (sesión y pases QR). Obligatorias en production.
# Salen de `node deploy/generate-keys.mjs`. Los PEM van en una sola línea con \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
TICKET_PRIVATE_KEY=
TICKET_PUBLIC_KEY=
TICKET_KID=eventia-prod-1

# Pagos: `fake` emite el boleto al instante. Para Stripe en modo prueba usa
# `auto` y pega llaves sk_test_ (el webhook necesita el dominio de la api).
PAYMENTS_MODE=fake
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Semilla de demo (cuentas de README.md). Solo corre si la base no tiene usuarios,
# así que puede quedarse en true. Con false la plataforma arranca vacía.
SEED_ON_BOOT=true
# Contraseña de las cuentas de demo. Obligatoria si SEED_ON_BOOT=true.
EVENTIA_DEMO_PASSWORD=
