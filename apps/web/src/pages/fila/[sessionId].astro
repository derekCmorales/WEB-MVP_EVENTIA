---
export const prerender = false;
import AppLayout from "../../layouts/AppLayout.astro";
import QueueIsland from "../../components/app/QueueIsland.tsx";
const { sessionId } = Astro.params;
if (!sessionId) return Astro.redirect("/explorar");
---
<AppLayout title="Fila · Eventia" description="Tu lugar en la fila de venta.">
  <QueueIsland client:load sessionId={sessionId} />
</AppLayout>
