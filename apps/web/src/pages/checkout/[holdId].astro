---
export const prerender = false;
import AppLayout from "../../layouts/AppLayout.astro";
import CheckoutIsland from "../../components/app/CheckoutIsland.tsx";
const { holdId } = Astro.params;
if (!holdId) return Astro.redirect("/explorar");
---
<AppLayout title="Pago · Eventia" description="Confirma el apartado y paga.">
  <CheckoutIsland client:load holdId={holdId} />
</AppLayout>
