---
export const prerender = false;
import AppLayout from "../../layouts/AppLayout.astro";
import EventIsland from "../../components/app/EventIsland.tsx";
const { slug } = Astro.params;
if (!slug) return Astro.redirect("/explorar");
---
<AppLayout title="Evento · Eventia" description="Detalle, cupo y precio final.">
  <EventIsland client:load slug={slug} />
</AppLayout>
