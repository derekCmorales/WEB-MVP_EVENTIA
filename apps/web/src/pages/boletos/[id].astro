---
export const prerender = false;
import AppLayout from "../../layouts/AppLayout.astro";
import TicketIsland from "../../components/app/TicketIsland.tsx";
const { id } = Astro.params;
if (!id) return Astro.redirect("/boletos");
---
<AppLayout title="Pase · Eventia" description="Código QR que rota solo.">
  <TicketIsland client:load ticketId={id} />
</AppLayout>
