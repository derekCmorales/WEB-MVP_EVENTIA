---
import { Image, getImage } from "astro:assets";
import i1470229722913_7c0e2dbbafd3 from "../assets/events/1470229722913-7c0e2dbbafd3.jpg";
---
<section style="position:relative;height:720px" class="duo"><Image src={i1470229722913_7c0e2dbbafd3} alt="Multitud frente a un escenario iluminado en un concierto" widths={[480,800,1200,1600]} sizes="(max-width: 768px) 100vw, 60vw" loading="eager" decoding="sync" /><div class="grain"></div>
<div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(28,25,23,0) 35%,rgba(28,25,23,.75));z-index:1"></div><span class="beam" style="left:30%"></span><span class="beam" style="left:62%;animation-delay:-3s"></span>
<div class="wrap" style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:72px;color:#fff;z-index:2">
<div class="eyebrow" style="color:rgba(255,255,255,.7)">Sábado · 21:00 · Explanada Cayalá</div>
<h2 class="kin" style="font-size:128px;letter-spacing:-.05em;line-height:.92;margin-top:18px">Sentirlo<br>en vivo.</h2>
<p style="max-width:520px;font-size:19px;margin-top:20px;color:rgba(255,255,255,.85)">La primera fila, el coro de todos, ese momento en que se apagan las luces. Eventia te deja ahí.</p></div></section>
