---
import { Image, getImage } from "astro:assets";
import i1492684223066_81342ee5ff30 from "../assets/events/1492684223066-81342ee5ff30.jpg";
import i1501281668745_f7f57925c3b4 from "../assets/events/1501281668745-f7f57925c3b4.jpg";
import i1514525253161_7a46d19cd819 from "../assets/events/1514525253161-7a46d19cd819.jpg";
---
<section class="wrap" style="padding:0 40px 120px;display:grid;grid-template-columns:2fr 1fr;grid-template-rows:320px 320px;gap:20px">
<div class="duo light" style="grid-row:span 2;border-radius:24px"><Image src={i1514525253161_7a46d19cd819} alt="Escenario de festival con confeti y luces" widths={[480,800,1200,1600]} sizes="(max-width: 768px) 100vw, 60vw" loading="eager" decoding="sync" /><div class="grain"></div><div style="position:absolute;left:32px;bottom:32px;z-index:2"><span class="badge" style="background:#fff">Conciertos</span><h3 style="font-size:44px;margin-top:14px;color:#1C1917;background:rgba(255,255,255,.85);padding:10px 16px;border-radius:12px">Cuando suena tu canción.</h3></div></div>
<div class="duo light" style="border-radius:24px"><Image src={i1492684223066_81342ee5ff30} alt="Público entre confeti en un festival" widths={[480,800,1200,1600]} sizes="(max-width: 768px) 100vw, 60vw" loading="eager" decoding="sync" /><div class="grain"></div><span class="badge" style="position:absolute;left:20px;bottom:20px;background:#fff;z-index:2">Festivales</span></div>
<div class="duo light" style="border-radius:24px"><Image src={i1501281668745_f7f57925c3b4} alt="Público levantando las manos en un concierto" widths={[480,800,1200,1600]} sizes="(max-width: 768px) 100vw, 60vw" loading="eager" decoding="sync" /><div class="grain"></div><span class="badge" style="position:absolute;left:20px;bottom:20px;background:#fff;z-index:2">Multitudes</span></div></section>
